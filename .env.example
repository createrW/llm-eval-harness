# Nothing loads this file by itself: export the variables in your shell, or copy it to .env
# (git-ignored) and prefix commands with UV_ENV_FILE=.env. Never commit real values.
# Uncomment only the lines you set: an empty value still overrides the default.
# API models (configs/eval/api_gen.yaml)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Gated Hugging Face models (the configs use an ungated Llama mirror, so this is optional)
# HF_TOKEN=
# Run from the local Hugging Face cache without network
# HF_HUB_OFFLINE=1
# HF_DATASETS_OFFLINE=1
# Code sha to record when .git is absent (Docker)
# LLM_EVAL_GIT_SHA=
# Runs the dashboard reads (default: data/samples/runs/)
# LLM_EVAL_RUNS_ROOT=
