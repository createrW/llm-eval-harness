# Copy to .env (git-ignored) or export in your shell. Never commit real values.
# API models (configs/eval/api_gen.yaml)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gated Hugging Face models (the configs use an ungated Llama mirror, so this is optional)
HF_TOKEN=
# Run from the local Hugging Face cache without network
HF_HUB_OFFLINE=
HF_DATASETS_OFFLINE=
# Code sha to record when .git is absent (Docker)
LLM_EVAL_GIT_SHA=
# Runs the dashboard reads (default: data/samples/runs/)
LLM_EVAL_RUNS_ROOT=
